{
    "name": "com.xmjgame.pullet-minigame",
    "version": "0.3.0",
    "displayName": "Pullet Mini Game",
    "description": "Optional WeChat, Douyin and extensible mini-game platform integration for Pullet Framework.",
    "unity": "2021.3",
    "dependencies": {
        "com.xmjgame.pullet-framework": "0.1.0"
    },
    "author": {
        "name": "XMJGame"
    },
    "keywords": [
        "minigame",
        "wechat",
        "douyin",
        "webgl"
    ],
    "samples": [
        {
            "displayName": "Platform Diagnostics",
            "description": "In-game validation panel for platform capabilities, lifecycle callbacks and leaderboards.",
            "path": "Samples~/Diagnostics"
        },
        {
            "displayName": "Douyin SDK Bridge",
            "description": "Runtime binding for TTSDK 6.9.3.",
            "path": "Samples~/DouyinSDK"
        },
        {
            "displayName": "WeChat SDK Bridge",
            "description": "Direct runtime binding for the official WeChat mini-game SDK.",
            "path": "Samples~/WeChatSDK"
        }
    ]
}
